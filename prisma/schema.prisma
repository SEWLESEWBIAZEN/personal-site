generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IdeaStatus {
  THOUGHT
  EXPLORING
  EXPERIMENTING
  IMPLEMENTED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  projects Project[]
  articles JournalArticle[]
  ideas    Idea[]

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  projects Project[]        @relation("ProjectTags")
  articles JournalArticle[] @relation("ArticleTags")
  ideas    Idea[]           @relation("IdeaTags")

  @@map("tags")
}

model Project {
  id                  String        @id @default(cuid())
  title               String
  slug                String        @unique
  shortDescription    String?
  description         String?
  problemStatement    String?
  solution            String?
  technicalChallenges String?
  architecture        String?
  keyFeatures         String?
  technologies        String[]
  coverImage          String?
  videoUrl            String?
  liveUrl             String?
  repositoryUrl       String?
  status              ContentStatus @default(DRAFT)
  isFeatured          Boolean       @default(false)
  displayOrder        Int           @default(0)
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  categoryId String?
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media      ProjectMedia[]
  tags       Tag[]          @relation("ProjectTags")

  @@index([status, isFeatured, displayOrder])
  @@index([categoryId])
  @@map("projects")
}

model ProjectMedia {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaType    MediaType @default(IMAGE)
  url          String
  thumbnailUrl String?
  altText      String?
  caption      String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([projectId, displayOrder])
  @@map("project_media")
}

model JournalArticle {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  /// Tiptap document JSON (editor source of truth)
  content     Json?
  /// Sanitized HTML rendered from `content`, used for public rendering
  contentHtml String?
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  readingTime Int?
  isFeatured  Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       Tag[]     @relation("ArticleTags")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("journal_articles")
}

model Idea {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  summary     String?
  content     Json?
  contentHtml String?
  status      IdeaStatus @default(THOUGHT)
  coverImage  String?
  isPublic    Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       Tag[]     @relation("IdeaTags")

  @@index([isPublic, status])
  @@index([categoryId])
  @@map("ideas")
}

model Media {
  id               String   @id @default(cuid())
  filename         String   @unique
  originalFilename String
  mimeType         String
  size             Int
  url              String
  storageProvider  String   @default("local")
  altText          String?
  createdAt        DateTime @default(now())

  @@map("media")
}

model SiteSettings {
  id           String   @id @default(cuid())
  siteTitle    String   @default("Sewlesew Biazen — Engineering Studio")
  tagline      String   @default("Software engineer, builder, explorer")
  introduction String?
  email        String?
  githubUrl    String?
  linkedinUrl  String?
  location     String?
  profileImage String?
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

model NowItem {
  id           String   @id @default(cuid())
  title        String
  description  String?
  category     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("now_items")
}
