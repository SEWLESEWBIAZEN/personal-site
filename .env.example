# --- Required in every environment ---------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/personal_studio"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL; also used for canonical URLs, sitemap and Open Graph.
AUTH_URL="http://localhost:3000"
# Needed behind a reverse proxy / in Docker so Auth.js trusts the Host header.
# AUTH_TRUST_HOST="true"

# --- Seeding only (prisma db seed) ---------------------------------------
# Creates this admin if it does not exist. Min 8 characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Set to "false" to skip the sample projects/articles.
SEED_SAMPLE_CONTENT="true"

# --- Media storage --------------------------------------------------------
# "local" (default) or "s3" (any S3-compatible service: AWS, R2, MinIO, Bunny S3).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# Required when STORAGE_PROVIDER="s3"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket's objects (CDN or bucket URL).
S3_PUBLIC_URL=""
